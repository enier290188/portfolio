{
    "root": true,
    "settings": {
        "react": {
            "pragma": "React",
            "version": "detect"
        }
    },
    "env": {
        "browser": true,
        "es2022": true
    },
    "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended", "plugin:react-hooks/recommended", "plugin:@tanstack/eslint-plugin-query/recommended", "prettier"],
    "ignorePatterns": ["dist", ".eslintrc.json"],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "plugins": ["@typescript-eslint", "react-hooks", "react-refresh", "@tanstack/query"],
    "rules": {
        "react-hooks/rules-of-hooks": "error",
        "react-hooks/exhaustive-deps": "warn",
        "react-refresh/only-export-components": [
            "warn",
            {
                "allowConstantExport": true
            }
        ],
        "@tanstack/query/exhaustive-deps": "error",
        "@tanstack/query/stable-query-client": "error"
    }
}
