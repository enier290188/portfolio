{
    "name": "portfolio",
    "version": "0.1.0",
    "description": "React-TypeScript application",
    "keywords": [
        "react",
        "typescript"
    ],
    "author": {
        "name": "Enier Ramos Garcia",
        "email": "enier290188@email.com",
        "url": "https://www.linkedin.com/in/enier290188/"
    },
    "contributors": [],
    "private": true,
    "license": "MIT",
    "engines": {
        "node": "v20.11.0",
        "npm": "10.7.0"
    },
    "type": "module",
    "scripts": {
        "dev": "vite dev --host localhost --port 3000 --cors --strictPort --force --debug",
        "build": "tsc && vite build --outDir dist --assetsDir asset --assetsInlineLimit 4096",
        "preview": "vite preview --host localhost --port 8080 --strictPort --outDir dist",
        "eslint:check": "tsc && npx eslint ./src --ext js,jsx,ts,tsx --quiet --report-unused-disable-directives --max-warnings 10",
        "eslint:fix": "npm run eslint:check -- --fix",
        "prettier:check": "tsc && npx prettier ./ --check",
        "prettier:fix": "npm run prettier:check -- --write"
    },
    "dependencies": {
        "@emotion/react": "11.11.4",
        "@emotion/styled": "11.11.5",
        "@fontsource/roboto": "5.0.13",
        "@mui/icons-material": "5.15.17",
        "@mui/material": "5.15.17",
        "react": "18.3.1",
        "react-dom": "18.3.1"
    },
    "devDependencies": {
        "@types/react": "18.3.2",
        "@types/react-dom": "18.3.0",
        "@typescript-eslint/eslint-plugin": "7.9.0",
        "@typescript-eslint/parser": "7.9.0",
        "@vitejs/plugin-react": "4.2.1",
        "eslint": "8.57.0",
        "eslint-config-prettier": "9.1.0",
        "eslint-plugin-react-hooks": "4.6.2",
        "eslint-plugin-react-refresh": "0.4.7",
        "prettier": "3.2.5",
        "typescript": "5.4.5",
        "vite": "5.2.11"
    }
}
