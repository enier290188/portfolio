ARG NODE_VERSION=22.12.0




FROM node:${NODE_VERSION}-alpine AS stage-development
RUN <<EOF
    apk update && apk upgrade --no-cache
    apk add --no-cache curl
    npm install -g npm@latest
EOF

ARG SERVICE_WEB_HOST
ARG SERVICE_WEB_PROTOCOL
ARG SERVICE_WEB_DOMAIN
ARG SERVICE_WEB_PORT_EXTERNAL
ARG SERVICE_WEB_PORT_INTERNAL
ARG SERVICE_API_PROTOCOL
ARG SERVICE_API_DOMAIN
ARG SERVICE_API_PORT

ENV SERVICE_WEB_HOST=$SERVICE_WEB_HOST
ENV SERVICE_WEB_PROTOCOL=$SERVICE_WEB_PROTOCOL
ENV SERVICE_WEB_DOMAIN=$SERVICE_WEB_DOMAIN
ENV SERVICE_WEB_PORT_EXTERNAL=$SERVICE_WEB_PORT_EXTERNAL
ENV SERVICE_WEB_PORT_INTERNAL=$SERVICE_WEB_PORT_INTERNAL
ENV VITE_SERVICE_API_PROTOCOL=$SERVICE_API_PROTOCOL
ENV VITE_SERVICE_API_DOMAIN=$SERVICE_API_DOMAIN
ENV VITE_SERVICE_API_PORT=$SERVICE_API_PORT

WORKDIR /usr/src/service/web/
COPY ./package*.json ./
RUN <<EOF
    npm i
EOF
COPY ./ ./
EXPOSE $SERVICE_WEB_PORT_INTERNAL
CMD npx vite dev --host $SERVICE_WEB_HOST --port $SERVICE_WEB_PORT_INTERNAL --cors --strictPort --force --debug




FROM node:${NODE_VERSION}-alpine AS stage-production-base
RUN <<EOF
    apk update && apk upgrade --no-cache
    apk add --no-cache curl
    npm install -g npm@latest
EOF

ARG SERVICE_WEB_HOST
ARG SERVICE_WEB_PROTOCOL
ARG SERVICE_WEB_DOMAIN
ARG SERVICE_WEB_PORT_EXTERNAL
ARG SERVICE_WEB_PORT_INTERNAL
ARG SERVICE_API_PROTOCOL
ARG SERVICE_API_DOMAIN
ARG SERVICE_API_PORT

ENV SERVICE_WEB_HOST=$SERVICE_WEB_HOST
ENV SERVICE_WEB_PROTOCOL=$SERVICE_WEB_PROTOCOL
ENV SERVICE_WEB_DOMAIN=$SERVICE_WEB_DOMAIN
ENV SERVICE_WEB_PORT_EXTERNAL=$SERVICE_WEB_PORT_EXTERNAL
ENV SERVICE_WEB_PORT_INTERNAL=$SERVICE_WEB_PORT_INTERNAL
ENV VITE_SERVICE_API_PROTOCOL=$SERVICE_API_PROTOCOL
ENV VITE_SERVICE_API_DOMAIN=$SERVICE_API_DOMAIN
ENV VITE_SERVICE_API_PORT=$SERVICE_API_PORT

WORKDIR /usr/src/service/web/


FROM stage-production-base AS stage-production-dependencies
COPY ./package*.json ./
RUN <<EOF
    npm ci
EOF


FROM stage-production-base AS stage-production-builder
COPY --from=stage-production-dependencies /usr/src/service/web/node_modules/ ./node_modules/
COPY ./ ./
RUN <<EOF
    npm run tsc
    npx vite build --outDir dist --assetsDir asset --assetsInlineLimit 4096
EOF


FROM nginx:1.27.2-alpine AS stage-production
RUN <<EOF
    apk update && apk upgrade --no-cache
    apk add --no-cache curl
    addgroup --system --gid 10001 nonroot
    adduser --system --uid 10001 nonroot --disabled-password --no-create-home
EOF

ARG SERVICE_WEB_HOST
ARG SERVICE_WEB_PROTOCOL
ARG SERVICE_WEB_DOMAIN
ARG SERVICE_WEB_PORT_EXTERNAL
ARG SERVICE_WEB_PORT_INTERNAL
ARG SERVICE_API_PROTOCOL
ARG SERVICE_API_DOMAIN
ARG SERVICE_API_PORT
ARG NGINX_HOST=$SERVICE_WEB_HOST
ARG NGINX_PORT=$SERVICE_WEB_PORT_INTERNAL

ENV SERVICE_WEB_HOST=$SERVICE_WEB_HOST
ENV SERVICE_WEB_PROTOCOL=$SERVICE_WEB_PROTOCOL
ENV SERVICE_WEB_DOMAIN=$SERVICE_WEB_DOMAIN
ENV SERVICE_WEB_PORT_EXTERNAL=$SERVICE_WEB_PORT_EXTERNAL
ENV SERVICE_WEB_PORT_INTERNAL=$SERVICE_WEB_PORT_INTERNAL
ENV VITE_SERVICE_API_PROTOCOL=$SERVICE_API_PROTOCOL
ENV VITE_SERVICE_API_DOMAIN=$SERVICE_API_DOMAIN
ENV VITE_SERVICE_API_PORT=$SERVICE_API_PORT
ENV NGINX_HOST=$NGINX_HOST
ENV NGINX_PORT=$NGINX_PORT

WORKDIR /usr/src/service/web/
RUN <<EOF
    cp -r -a /usr/share/nginx/html/* ./
EOF
COPY --from=stage-production-builder --chown=nonroot:nonroot /usr/src/service/web/dist/ ./
EXPOSE $NGINX_PORT
CMD ["nginx", "-g", "daemon off;"]
