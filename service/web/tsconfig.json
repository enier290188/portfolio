{
    "compilerOptions": {
        /* App */
        "baseUrl": ".",
        "paths": {
            "@./app": ["./src/app"],
            "@./app/page/account": ["./src/app/page/account"],
            "@./app/page/error": ["./src/app/page/error"],
            "@./app/page/workspace": ["./src/app/page/workspace"],
            "@./package/material-ui": ["./src/package/material-ui"],
            "@./package/react-error-boundary": ["./src/package/react-error-boundary"],
            "@./package/react-router": ["./src/package/react-router"],
            "@./package/tanstack-react-query": ["./src/package/tanstack-react-query"],
            "@./package/tanstack-react-query-devtools": ["./src/package/tanstack-react-query-devtools"],
            "@./package/tanstack-react-table": ["./src/package/tanstack-react-table"]
        },
        /* Vite Default */
        "target": "ES2022",
        "useDefineForClassFields": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["src"],
    "references": [
        {
            "path": "./tsconfig.node.json"
        }
    ]
}
