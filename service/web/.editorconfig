root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = false
indent_style = space
indent_size = 2
max_line_length = 1000
ij_visual_guides = 250
trim_trailing_whitespace = true

[*.md]
indent_size = 4

[*.{html,css}]
indent_size = 4

[*.{ts,tsx}]
indent_size = 4

[*.{js,jsx}]
indent_size = 4

[*.{json,yml,yaml,mjs}]
indent_size = 4
